# ANKA OS — Calamares branding
# Keys: https://github.com/calamares/calamares/blob/calamares/src/branding/default/branding.desc
---
componentName: anka

welcomeStyleCalamares: false
welcomeExpandingLogo:  true

windowExpanding:  normal
windowSize:       860px,560px
windowPlacement:  center

sidebar:    widget
navigation: widget

strings:
  productName:         "ANKA OS"
  shortProductName:    "ANKA"
  version:             ""
  shortVersion:        ""
  versionedName:       "ANKA OS"
  shortVersionedName:  "ANKA"
  bootloaderEntryName: "ANKA OS"
  productUrl:          "https://github.com/biyusku/anka-os"
  supportUrl:          "https://github.com/biyusku/anka-os/issues"
  knownIssuesUrl:      "https://github.com/biyusku/anka-os/issues"
  releaseNotesUrl:     "https://github.com/biyusku/anka-os/releases"

images:
  productLogo:    "logo.svg"
  productIcon:    "logo.svg"
  productWelcome: "logo.svg"

# Deep red + gold (docs/branding.md)
style:
  SidebarBackground:        "#1a0a0a"
  SidebarText:              "#f2e6cf"
  SidebarTextCurrent:       "#ffffff"
  SidebarBackgroundCurrent: "#c0392b"

slideshow:    "show.qml"
slideshowAPI: 2
